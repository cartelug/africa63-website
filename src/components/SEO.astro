---
import { site } from '../config/site';
import { localizePath, type Lang } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  path: string;          // canonical path without locale prefix, e.g. "/about" or "/"
  ogImage?: string;      // absolute or root-relative
  type?: 'website' | 'article';
  jsonld?: object;
}
const { title, description, lang, path, ogImage = '/assets/images/generated/og-share.jpg', type = 'website', jsonld } = Astro.props;

const url = site.domain + localizePath(path, lang);
const enUrl = site.domain + localizePath(path, 'en');
const frUrl = site.domain + localizePath(path, 'fr');
const ogAbs = ogImage.startsWith('http') ? ogImage : site.domain + ogImage;
---
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={url} />

<link rel="alternate" hreflang="en" href={enUrl} />
<link rel="alternate" hreflang="fr" href={frUrl} />
<link rel="alternate" hreflang="x-default" href={enUrl} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:url" content={url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogAbs} />
<meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogAbs} />

<meta name="theme-color" content="#0c0b09" />
<link rel="icon" href="/assets/logo/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/assets/logo/favicon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/assets/logo/favicon-16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/assets/logo/apple-touch-icon.png" />

{jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
