---
// First-visit language chooser (home page only).
// English + French are native site translations; every other language is
// rendered on the fly via Google Translate's proxy (translate.goog).
import { localizePath, type Lang } from '../i18n/ui';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const homeEn = localizePath('/', 'en');
const homeFr = localizePath('/', 'fr');

// { code (Google Translate tl), english name, native name }
const LANGS: [string, string, string][] = [
  ['en', 'English', 'English'],
  ['fr', 'French', 'Français'],
  ['es', 'Spanish', 'Español'],
  ['pt', 'Portuguese', 'Português'],
  ['ar', 'Arabic', 'العربية'],
  ['sw', 'Swahili', 'Kiswahili'],
  ['ln', 'Lingala', 'Lingála'],
  ['lg', 'Luganda', 'Luganda'],
  ['rw', 'Kinyarwanda', 'Ikinyarwanda'],
  ['zh-CN', 'Chinese (Simplified)', '中文（简体）'],
  ['zh-TW', 'Chinese (Traditional)', '中文（繁體）'],
  ['hi', 'Hindi', 'हिन्दी'],
  ['de', 'German', 'Deutsch'],
  ['ru', 'Russian', 'Русский'],
  ['ja', 'Japanese', '日本語'],
  ['ko', 'Korean', '한국어'],
  ['it', 'Italian', 'Italiano'],
  ['nl', 'Dutch', 'Nederlands'],
  ['tr', 'Turkish', 'Türkçe'],
  ['pl', 'Polish', 'Polski'],
  ['uk', 'Ukrainian', 'Українська'],
  ['fa', 'Persian', 'فارسی'],
  ['ur', 'Urdu', 'اردو'],
  ['bn', 'Bengali', 'বাংলা'],
  ['pa', 'Punjabi', 'ਪੰਜਾਬੀ'],
  ['ta', 'Tamil', 'தமிழ்'],
  ['te', 'Telugu', 'తెలుగు'],
  ['ml', 'Malayalam', 'മലയാളം'],
  ['kn', 'Kannada', 'ಕನ್ನಡ'],
  ['mr', 'Marathi', 'मराठी'],
  ['gu', 'Gujarati', 'ગુજરાતી'],
  ['th', 'Thai', 'ไทย'],
  ['vi', 'Vietnamese', 'Tiếng Việt'],
  ['id', 'Indonesian', 'Bahasa Indonesia'],
  ['ms', 'Malay', 'Bahasa Melayu'],
  ['fil', 'Filipino', 'Filipino'],
  ['he', 'Hebrew', 'עברית'],
  ['el', 'Greek', 'Ελληνικά'],
  ['ro', 'Romanian', 'Română'],
  ['hu', 'Hungarian', 'Magyar'],
  ['cs', 'Czech', 'Čeština'],
  ['sv', 'Swedish', 'Svenska'],
  ['da', 'Danish', 'Dansk'],
  ['fi', 'Finnish', 'Suomi'],
  ['no', 'Norwegian', 'Norsk'],
  ['sk', 'Slovak', 'Slovenčina'],
  ['bg', 'Bulgarian', 'Български'],
  ['sr', 'Serbian', 'Српски'],
  ['hr', 'Croatian', 'Hrvatski'],
  ['sl', 'Slovenian', 'Slovenščina'],
  ['lt', 'Lithuanian', 'Lietuvių'],
  ['lv', 'Latvian', 'Latviešu'],
  ['et', 'Estonian', 'Eesti'],
  ['ca', 'Catalan', 'Català'],
  ['gl', 'Galician', 'Galego'],
  ['eu', 'Basque', 'Euskara'],
  ['sq', 'Albanian', 'Shqip'],
  ['mk', 'Macedonian', 'Македонски'],
  ['bs', 'Bosnian', 'Bosanski'],
  ['is', 'Icelandic', 'Íslenska'],
