  ['mg', 'Malagasy', 'Malagasy'],
  ['ne', 'Nepali', 'नेपाली'],
  ['si', 'Sinhala', 'සිංහල'],
  ['my', 'Burmese', 'မြန်မာ'],
  ['km', 'Khmer', 'ខ្មែរ'],
  ['lo', 'Lao', 'ລາວ'],
