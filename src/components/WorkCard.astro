---
import { Image } from 'astro:assets';
import { img } from '../lib/images';
interface Props {
  href: string; cover: string; title: string; year: string;
  chips?: string[]; tag?: string; span?: 5 | 7; eager?: boolean;
}
const { href, cover, title, year, chips = [], tag, span = 7, eager = false } = Astro.props;
---
<a href={href} class={`work-card span-${span} reveal`}>
  <div class="work-media">
    {tag && <span class="work-tag">{tag}</span>}
    <Image src={img(cover)} alt={title} widths={[480, 800, 1200]} sizes="(max-width: 1080px) 100vw, 55vw"
      loading={eager ? 'eager' : 'lazy'} decoding="async" />
  </div>
  <div class="work-meta">
    <div class="wm-info">
      {chips.map((c) => <span class="work-chip">{c}</span>)}
      <div class="t">{title}</div>
      <div class="y">{year}</div>
    </div>
    <span class="wm-arrow" aria-hidden="true">→</span>
  </div>
</a>
