---
import { Image } from 'astro:assets';
import { img } from '../lib/images';
interface Props { href: string; cover: string; category: string; title: string; excerpt: string; date: string; lang: string; }
const { href, cover, category, title, excerpt, date, lang } = Astro.props;
const dateFmt = new Date(date).toLocaleDateString(lang === 'fr' ? 'fr-FR' : 'en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
---
<a href={href} class="insight-card reveal">
  <div class="media">
    <Image src={img(cover)} alt={title} widths={[400, 700]} sizes="(max-width: 700px) 100vw, 340px" loading="lazy" />
  </div>
  <span class="cat">{category}</span>
  <h3>{title}</h3>
  <p class="excerpt">{excerpt}</p>
  <span class="date">{dateFmt}</span>
</a>
