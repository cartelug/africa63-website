---
import { useTranslations, type Lang } from '../i18n/ui';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<div id="loader" role="status" aria-label="Loading Africa 63">
  <div class="loader-core">
    <div class="loader-tag">
      <span class="lt-line" aria-hidden="true"></span>
      <span>{t('tag.public')}</span>
      <span class="lt-dot" aria-hidden="true"></span>
      <span>{t('tag.strategic')}</span>
      <span class="lt-line" aria-hidden="true"></span>
    </div>
    <div class="loader-logo"><img src="/assets/logo/africa63-full-logo.PNG" alt="Africa 63" width="300" height="120" /></div>
    <div class="loader-track"><span class="loader-bar"></span></div>
  </div>
  <div class="loader-note">{t('loader.note')}</div>
  <div class="loader-pct">000</div>
</div>
